# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube a git.

# API key de Anthropic (https://console.anthropic.com) — vive SOLO en el servidor
ANTHROPIC_API_KEY=

# Contraseña de acceso a las funciones de IA. Opcional en local,
# OBLIGATORIA si publicas la app en internet (evita que terceros gasten tu cuenta).
APP_PASSWORD=

# Puerto del servidor (3000 por defecto)
PORT=3000
